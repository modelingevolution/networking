<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ModelingEvolution.NetworkManager.Contracts</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelingEvolution.NetworkManager\ModelingEvolution.NetworkManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MicroPlumberd" Version="1.1.6" />
    <PackageReference Include="MicroPlumberd.Encryption" Version="1.1.6" />
    <PackageReference Include="MicroPlumberd.Services" Version="1.1.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="ModelingEvolution.Ipv4" Version="1.1.*" />
    <PackageReference Include="ModelingEvolution.JsonParsableConverter" Version="1.0.1" />
    <PackageReference Include="protobuf-net" Version="3.*" />
  </ItemGroup>

</Project>
