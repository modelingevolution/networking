@using ModelingEvolution.NetworkManager.Contracts
@using MicroPlumberd
@inject VmHostRegister<DnsConfigurationVm> _vmRegister
@inject IDialogService DialogService

<MudCard Elevation="2" Class="dns-card">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Dns" />
                <MudText Typo="Typo.h6">DNS</MudText>
                @if (_vm?.State.DnsMethod == DnsMethod.Auto)
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">DHCP</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">Manual</MudChip>
                }
            </MudStack>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="OpenEditDialog">Edit</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if (_vm != null)
        {
            <Observable Source="_vm">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2" Class="label-text">DNS assignment</MudText>
                        <MudText Typo="Typo.body2">@(_vm.State.DnsMethod == DnsMethod.Auto ? "Automatic (DHCP)" : "Manual")</MudText>
                    </MudStack>

                    @if (_vm.State.PrimaryDns.HasValue)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="label-text">Primary DNS</MudText>
                            <MudText Typo="Typo.body2">@_vm.State.PrimaryDns</MudText>
                        </MudStack>
                    }

                    @if (_vm.State.SecondaryDns.HasValue)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="label-text">Secondary DNS</MudText>
                            <MudText Typo="Typo.body2">@_vm.State.SecondaryDns</MudText>
                        </MudStack>
                    }

                    @if (!_vm.State.PrimaryDns.HasValue && !_vm.State.SecondaryDns.HasValue)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">DNS servers obtained from DHCP</MudText>
                    }
                </MudStack>
            </Observable>
        }
        else
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
    </MudCardContent>
</MudCard>

@code {
    private DnsConfigurationVm? _vm;

    [Parameter]
    public HostName HostName { get; set; }

    [Parameter]
    public string InterfaceName { get; set; } = "eth0";

    protected override async Task OnParametersSetAsync()
    {
        var vmHost = _vmRegister.Get(HostName);
        _vm = await vmHost.Initialize(HostName, InterfaceName);
    }

    private async Task OpenEditDialog()
    {
        if (_vm == null) return;

        var parameters = new DialogParameters<EditDnsDialog>
        {
            { x => x.Method, _vm.State.DnsMethod },
            { x => x.PrimaryDns, _vm.State.PrimaryDns?.ToString() ?? "" },
            { x => x.SecondaryDns, _vm.State.SecondaryDns?.ToString() ?? "" }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditDnsDialog>("Edit DNS", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: EditDnsDialog.EditDnsResult data })
        {
            _vm.EditMethod = data.Method;
            _vm.EditPrimaryDns = data.PrimaryDns;
            _vm.EditSecondaryDns = data.SecondaryDns;
            await _vm.SaveEdit();
        }
    }
}
