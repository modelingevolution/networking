@using ModelingEvolution.NetworkManager.Contracts

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Dns" />
            <MudText Typo="Typo.h6">Edit DNS</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <EditDnsControl @bind-Method="Method"
                        @bind-PrimaryDns="PrimaryDns"
                        @bind-SecondaryDns="SecondaryDns" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public DnsMethod Method { get; set; }
    [Parameter] public string PrimaryDns { get; set; } = "";
    [Parameter] public string SecondaryDns { get; set; } = "";

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        var result = new EditDnsResult
        {
            Method = Method,
            PrimaryDns = PrimaryDns,
            SecondaryDns = SecondaryDns
        };
        MudDialog.Close(DialogResult.Ok(result));
    }

    public class EditDnsResult
    {
        public DnsMethod Method { get; set; }
        public string PrimaryDns { get; set; } = "";
        public string SecondaryDns { get; set; } = "";
    }
}
